# Copia este archivo a .env.local (o define las variables en el entorno de
# despliegue). NUNCA escribas valores reales en el repositorio.

# --- Base de datos (Neon PostgreSQL) ---
# Pooled (host con -pooler): la usa la app en runtime.
DATABASE_URL="postgresql://usuario:password@host-pooler/base?sslmode=require"
# Directa (sin -pooler): la usa Prisma en `migrate deploy`. Obligatoria.
DIRECT_URL="postgresql://usuario:password@host/base?sslmode=require"

# --- Sitio público ---
NEXT_PUBLIC_SITIO_URL="https://ternio.cl"
# Correo opcional extra en /proveedores. El formulario de lista de espera
# no depende de esta variable.
NEXT_PUBLIC_CONTACTO_PROVEEDORES=""

# Google Tag Manager. El ID es público: viaja en el HTML. En producción
# conviene definirlo para que el contenedor salga en el build. Si no se
# define, el código usa GTM-K3F8GGHV. Déjalo vacío para no inyectar el tag.
NEXT_PUBLIC_GTM_ID="GTM-K3F8GGHV"

# --- GA4 Data API (solo /admin, lectura) ---
# Property numérica de Ternio. Nunca un GTM- ni un G-. Vacío = no conectado.
GA4_PROPERTY_ID=""
# JSON completo de la service account (Viewer en esa property). Vacío = no
# conectado. Nunca pegues el JSON real aquí.
GA4_SERVICE_ACCOUNT_JSON=""

# --- Auth.js v5 ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth quedó obsoleto: la sesión del comprador es por OTP de teléfono.
# AUTH_GOOGLE_ID y AUTH_GOOGLE_SECRET ya no se usan.

# --- SMS (Twilio) para el código OTP del comprador ---
# Sin estas variables, en desarrollo el código se imprime en el log local.
# En producción el envío falla de forma explícita y no se crea sesión.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Admin (ruta fija /admin + provider Credentials) ---
# La seguridad real es el rol ADMIN validado en servidor. Sin enlaces en el
# sitio, fuera del sitemap y sin entrada en robots.txt.
ADMIN_EMAIL=""
# Genera el hash con: pnpm hash:password 'tu-password'
ADMIN_PASSWORD_HASH=""

# --- Cloudflare Turnstile (antifraude del formulario) ---
# Sin TURNSTILE_SECRET_KEY en producción, la creación de leads falla
# explícitamente (fail-closed): nunca se guarda un lead sin verificación.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Solo para tests/desarrollo local: omite la verificación de Turnstile.
# Se ignora cuando NODE_ENV=production.
TURNSTILE_MODO_TEST="false"

# --- Flow Checkout (packs de créditos) ---
# En Vercel (proyecto ternio) FLOW_API_KEY y FLOW_SECRET_KEY ya existen.
# Sin estas variables el pack de arranque (alta) igual funciona.
# Nunca escribas valores reales aquí.
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
# Opcional. Default: https://www.flow.cl/api
# FLOW_API_URL=""
# Opcional. true/1 usa https://sandbox.flow.cl/api si no hay FLOW_API_URL.
# FLOW_SANDBOX=""

# --- Correo transaccional (Resend) ---
# Sin RESEND_API_KEY los avisos no se envían (fail-soft: no bloquea el lead
# ni la toma). Nunca escribas la key real aquí.
RESEND_API_KEY=""
# Opcional. Default: Ternio <avisos@ternio.cl>
# RESEND_FROM=""
# Opcional. Avisos de marketplace al admin (nueva cotización, alta de
# proveedor, toma de lead). Default: carlos.irigoyen@gmail.com
# ADMIN_AVISO_EMAIL=""
