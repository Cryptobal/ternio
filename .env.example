# Copia este archivo a .env.local (o define las variables en el entorno de
# despliegue). NUNCA escribas valores reales en el repositorio.

# --- Base de datos (Neon PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@host/base?sslmode=require"

# --- Auth.js v5 ---
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (cuenta del comprador). Sin estas variables el sitio sigue
# capturando leads: la pantalla post-envío avisa que la cuenta no está
# disponible y el lead queda guardado para revisión del admin.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Admin (ruta oculta + provider Credentials) ---
# Segmento de URL bajo el que se sirve el panel de admin. Sin enlaces en el
# sitio, fuera del sitemap y sin entrada en robots.txt. Rotarlo deja la ruta
# anterior en 404 de inmediato.
ADMIN_PATH="cambia-esto-por-algo-largo-y-aleatorio"
ADMIN_EMAIL=""
# Genera el hash con: pnpm hash:password 'tu-password'
ADMIN_PASSWORD_HASH=""

# --- Cloudflare Turnstile (antifraude del formulario) ---
# Sin TURNSTILE_SECRET_KEY en producción, la creación de leads falla
# explícitamente (fail-closed): nunca se guarda un lead sin verificación.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Solo para tests/desarrollo local: omite la verificación de Turnstile.
# Se ignora cuando NODE_ENV=production.
TURNSTILE_MODO_TEST="false"
